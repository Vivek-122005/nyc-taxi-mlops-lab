# Copy to aws.env (gitignored) and fill the three Learner Lab session secrets.
#   cp aws.env.example aws.env
# Then either:
#   set -a && source ./aws.env && set +a
#   make aws-check
# Lab scripts (health, dagster-run, catch-up, …) auto-load ./aws.env when present.
# Session secrets die when the Learner Lab session ends — update only those three lines and re-run.

# --- Learner Lab session (paste from AWS Details after Start Lab) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Region (fixed for this lab) ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Account / roles (known for this checkout; not secrets) ---
AWS_ACCOUNT_ID=851725514321
LAB_ROLE_ARN=arn:aws:iam::851725514321:role/LabRole
LAB_INSTANCE_PROFILE_ARN=arn:aws:iam::851725514321:instance-profile/LabInstanceProfile
TF_STATE_BUCKET=lab-tfstate-851725514321

# --- Buckets / warehouse (from instructor + terraform; not secrets) ---
LAB_DATA_BUCKET=nst-mlops-2026
LAB_ARTIFACT_BUCKET=lab-artifacts-851725514321
REDSHIFT_CLUSTER_ID=lab
REDSHIFT_DATABASE=lab
REDSHIFT_DB_USER=labadmin

# --- Repo / notebook ---
GITHUB_REPO=Vivek-122005/nyc-taxi-mlops-lab

# --- S2 promotion gate (set after you measure MAE / p95 on the holdout; leave blank until then) ---
# PROMOTION_MIN_MAE_IMPROVEMENT_MIN=
# PROMOTION_MAX_P95_LATENCY_MS=
